      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shutting Down"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在关机"
          }
        }
      }
    },
    "Start with Xcode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with Xcode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Xcode 开始。"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        }
      }
    },
    "Xcode did not provide a valid developer directory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode did not provide a valid developer directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 未提供有效的开发者目录。"
          }
        }
      }
    },
    "Xcode is not installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode is not installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装 Xcode。"
          }
        }
      }
    },
    "Xcode provides the tools SimStore needs to run iOS apps.\nInstall it from the App Store, then open it to finish setup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode provides the tools SimStore needs to run iOS apps.\nInstall it from the App Store, then open it to finish setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 提供 SimStore 运行 iOS 应用所需的工具。\n请从 App Store 安装，然后打开 Xcode 完成设置。"
          }
        }
      }
    },
    "Xcode required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Xcode"
          }
        }
      }
    },
    "Your iPhone and iPad simulators will appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone and iPad simulators will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 iPad 模拟器将显示在这里。"
          }
        }
      }
    },
    "Your simulators are ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your simulators are ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器已就绪"
          }
        }
      }
    },
    "iOS %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %@ · %@"
          }
        }
      }
