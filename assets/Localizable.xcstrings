{
  "sourceLanguage": "en",
  "strings": {
    "%@ couldn’t be opened. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn’t be opened. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。%@"
          }
        }
      }
    },
    "%@ couldn’t be opened. Make sure the full Xcode application is installed and selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn’t be opened. Make sure the full Xcode application is installed and selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。请确认已安装并选中完整的 Xcode 应用。"
          }
        }
      }
    },
    "%@ exited with status %d.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exited with status %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出，退出码为 %d。"
          }
        }
      }
    },
    "A simulator is where it starts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A simulator is where it starts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一台模拟器开始。"
          }
        }
      }
    },
    "App Repository": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Repository"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用仓库"
          }
        }
      }
    },
    "Booted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Booted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启动"
          }
        }
      }
    },
    "Booting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Booting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动"
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "Check for Simulators": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Simulators"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查模拟器"
          }
        }
      }
    },
    "Check for iOS simulators": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for iOS simulators"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查可用的 iOS 模拟器"
          }
        }
      }
    },
    "Checking for devices…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking for devices…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查设备…"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "Couldn’t Open Application": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Open Application"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开应用"
          }
        }
      }
    },
    "Couldn’t check for simulators": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check for simulators"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查模拟器"
          }
        }
      }
    },
    "Create an iPhone or iPad simulator in %@.\nThen come back to find your next favorite app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an iPhone or iPad simulator in %@.\nThen come back to find your next favorite app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中创建 iPhone 或 iPad 模拟器。\n然后回来发现你喜爱的应用。"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详情"
          }
        }
      }
    },
    "Device Hub or Simulator couldn’t be found in the selected Xcode installation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Hub or Simulator couldn’t be found in the selected Xcode installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选的 Xcode 中找不到 Device Hub 或 Simulator。"
          }
        }
      }
    },
    "Discover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现"
          }
        }
      }
    },
    "Found %lld available iOS simulators.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Found %lld available iOS simulator."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Found %lld available iOS simulators."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 %lld 台可用的 iOS 模拟器。"
          }
        }
      }
    },
    "Install Xcode to add iPhone and iPad simulators.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Xcode to add iPhone and iPad simulators."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Xcode 以添加 iPhone 和 iPad 模拟器。"
          }
        }
      }
    },
    "Installed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        }
      }
    },
    "Looking for your simulators…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for your simulators…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找模拟器…"
          }
        }
      }
    },
    "Make sure Xcode is installed and its command-line tools are selected, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure Xcode is installed and its command-line tools are selected, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认已安装 Xcode 并选中其命令行工具，然后重试。"
          }
        }
      }
    },
    "No devices to display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices to display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无设备"
          }
        }
      }
    },
    "No simulator selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No simulator selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择模拟器"
          }
        }
      }
    },
    "No simulators yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No simulators yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无模拟器"
          }
        }
