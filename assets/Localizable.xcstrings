    "OK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Open %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 %@"
          }
        }
      }
    },
    "Open %@ in your web browser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ in your web browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中打开 %@。"
          }
        }
      }
    },
    "Open App Store": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open App Store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 App Store"
          }
        }
      }
    },
    "Open Xcode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Xcode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Xcode"
          }
        }
      }
    },
    "Open the App Store and search for Xcode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the App Store and search for Xcode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 App Store 并搜索 Xcode。"
          }
        }
      }
    },
    "Open-source favorites. Built for your simulator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source favorites. Built for your simulator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你喜爱的开源应用，专为模拟器构建。"
          }
        }
      }
    },
    "SIMULATORS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMULATORS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器"
          }
        }
      }
    },
    "Shutdown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
